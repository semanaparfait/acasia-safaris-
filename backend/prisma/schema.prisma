// Database schema: each "model" below becomes a table in your Neon Postgres database.
// Every id is a UUID created by the database, e.g. "3f2a9c1e-…".
// After changing this file run:  npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

// ---------- Tour packages ----------

model Package {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  category    String // "Gorilla Trekking", "Wildlife Safari", ...
  badge       String?
  location    String
  description String
  tripType    String
  lodging     String
  image       String
  price       Int // USD per person
  minPrice    Int? // lowest adult price the team accepts when bargaining (admins only, never sent to the website)
  quotation   String? // URL of the quotation PDF (in the "tourpackages" bucket)

  // false = the PDF is made from this package and is remade each time it is saved.
  // true = the admin uploaded their own PDF, which is left alone.
  quotationManual Boolean  @default(false)
  rates           Json? // prices in the PDF: [{ label, ages, price }]. Empty = the default rates
  fairPrice       String[] @default([]) // reasons for "Why this price is fair", e.g. "Title: explanation"
  whyChoose       String[] @default([]) // reasons for "Why people choose this trip", written the same way

  active     Boolean        @default(true) // false = draft, hidden from the website
  route      String[] // stops in travel order
  inclusions String[]
  exclusions String[]
  perks      String[]
  itinerary  ItineraryDay[] // the number of days = the package duration
  bookings   Booking[]

  // French and Swahili texts (see src/translations): { fr: { "<key>": { t, src, edited? } }, sw: {...} }
  // Never sent as-is: the website gets the package already in its language (?lang=fr).
  translations Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ItineraryDay {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day         Int // 1, 2, 3 ...
  title       String
  description String
  image       String
  packageId   String  @db.Uuid
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, day])
}

// ---------- Destinations ----------

model Destination {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  group       String // "Wildlife", "Nature", "Culture", ...
  location    String
  image       String
  highlights  String[]
  bestTime    String
  fromKigali  String
  featured    Boolean  @default(false)

  // Choices on the booking form. Empty = the website uses the defaults for the group.
  travelStyles   String[] @default([])
  accommodations String[] @default([])
  budgets        String[] @default([])

  // French and Swahili texts, like Package.translations
  translations Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Workers (staff) ----------

model Worker {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  // Company email: made from the first name, e.g. "jean@acaciasafaris.com". Used to log in.
  email         String   @unique
  // The worker's own email (e.g. Gmail). The forgot-password code is sent here.
  personalEmail String?
  phone         String
  role          String // name of a Role, e.g. "Tour Guide"
  languages     String[]
  status        String   @default("Active") // "Active", "On leave", "Inactive"
  joined        DateTime @default(now())
  notes         String?

  // About us page. Shown there when showOnWebsite is on (and the worker is Active).
  showOnWebsite Boolean @default(false)
  companyRole   String? // title on the website, e.g. "CEO & Founder" (role above is the internal job)
  bio           String? // short text for visitors (notes stay private)
  socials       Json    @default("{}") // links: { youtube, instagram, x, tiktok, snapchat, facebook }
  photo         String? // image URL (uploaded to the "workers" bucket)

  // Second role: workers with isAdmin can log in to the admin panel with email + password
  isAdmin      Boolean @default(false)
  passwordHash String? // bcrypt hash, never sent to the browser
  tokenVersion Int     @default(0) // raised on logout and password change: older login tokens stop working

  // Forgot password: a 6 digit code emailed to personalEmail (only its bcrypt hash is stored)
  resetCodeHash    String?
  resetCodeExpires DateTime?
  resetAttempts    Int       @default(0) // wrong codes typed; the code stops working after 5

  // Two-step login: after the password, a 6 digit code is emailed to personalEmail
  loginCodeHash    String?
  loginCodeExpires DateTime?
  loginAttempts    Int       @default(0)

  // The main admin (only one): cannot be deleted, always keeps admin access,
  // and is the only one who can give or remove admin access. Set from .env by the seed.
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Worker roles (managed in Admin > Roles) ----------

// Worker.role holds the role's name. Renaming a role updates its workers too,
// and a role cannot be deleted while workers have it.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique // e.g. "Tour Guide"
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Bookings ----------

model Booking {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer     String
  email        String
  phone        String?
  country      String
  packageId    String?              @db.Uuid // empty when the trip is built from destinations
  package      Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  destinations BookingDestination[]
  startDate    DateTime
  endDate      DateTime
  travelers    Int // adults + children
  children     Int                  @default(0)
  amount       Int // total in USD, 0 until the admin sets the price of a destination trip
  status       String               @default("Pending") // "Pending", "Confirmed", "Completed", "Cancelled"
  payment      String               @default("Unpaid") // "Unpaid", "Deposit", "Paid", "Refunded"
  notes        String?

  // Price and bargaining. amount (above) is the price the booking is at now.
  guests      Json? // package bookings: travelers per price group, e.g. [{ label: "Adult", count: 2, price: 1450 }]
  listAmount  Int     @default(0) // the full price when booked
  floorAmount Int? // lowest total the team accepts (from Package.minPrice), admins only
  offer       Int? // a price proposal waiting for an answer
  offerBy     String? // who made it: "customer" or "team"
  needsReply  Boolean @default(false) // the customer wrote last and the team has not answered

  // The visitor's private link to their booking: /my-booking/<accessToken>
  // The website's language when booking ("en", "fr", "sw"): every email to the visitor uses it
  locale String @default("en")

  accessToken String @unique

  // Ticket: made when the booking is confirmed. Its QR code is in the confirmation email
  // and on the booking page; the team scans it in Admin > Check-in on the day.
  ticketCode  String?   @unique // e.g. "AC7K2M9QXP"
  checkedInAt DateTime? // when the QR code was scanned

  // Automatic emails (backend/src/reminders): when each was sent, so it is sent only once
  tripReminderAt    DateTime? // 7 days before the trip, with the QR code
  balanceReminderAt DateTime? // the remaining 50% (sent again a week later while still unpaid)
  reviewRequestAt   DateTime? // after the trip: "How was it?"
  reviewedAt        DateTime? // the traveler left a review from their booking page
  messages          BookingMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The conversation on a booking (bargaining, questions). Visitors write from their
// booking page, the team from Admin > Bookings.
model BookingMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender     String // "customer" or "team"
  authorName String // the customer's name, or the worker who answered
  text       String
  offer      Int? // a price proposed with this message
  event      String? // "offer", "accepted" (shown differently in the thread)
  createdAt  DateTime @default(now())

  @@index([bookingId, createdAt])
}

// One destination of a booking, with what the visitor chose for it.
// The title is stored as text: it can be a place the visitor typed, and it stays if the destination is deleted.
model BookingDestination {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  travelStyle   String
  accommodation String
  budget        String
  bookingId     String  @db.Uuid
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ---------- Messages (contact form) ----------

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  phone      String?
  subject    String
  body       String
  source     String   @default("Contact form") // "Contact form", "Booking request", "WhatsApp"
  read       Boolean  @default(false)
  starred    Boolean  @default(false)
  receivedAt DateTime @default(now())
}

// ---------- Reviews (Testimonials on the home page) ----------

model Review {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  country      String
  rating       Int // 1 to 5
  packageTitle String?
  text         String
  status       String   @default("Pending") // "Pending", "Published", "Hidden"
  createdAt    DateTime @default(now())
}

// ---------- Gallery (photos on the gallery page) ----------

model GalleryItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  category  String // "Wildlife", "Landscapes", "Culture", "People"
  location  String?
  image     String // image URL (uploaded to the "gallery" bucket)
  createdAt DateTime @default(now())
}

// ---------- Activity log (Admin > Activity) ----------

// Who did what in the admin panel, and when: prices, offers, deletions, check-ins, logins...
// Kept even when the worker or the booking is deleted.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId   String?  @db.Uuid // null for failed logins of unknown emails
  workerName String
  action     String // e.g. "Accepted the customer's price"
  target     String? // what it was done to, e.g. "Booking #3F2A9C1E"
  details    Json? // the changes sent (passwords and codes are never kept)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
