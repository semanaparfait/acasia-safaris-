// Database schema: each "model" below becomes a table in your Neon Postgres database.
// Every id is a UUID created by the database, e.g. "3f2a9c1e-…".
// After changing this file run:  npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

// ---------- Tour packages ----------

model Package {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  category    String // "Gorilla Trekking", "Wildlife Safari", ...
  badge       String?
  location    String
  description String
  tripType    String
  lodging     String
  image       String
  price       Int // USD per person
  quotation   String? // URL of the quotation PDF (in the "tourpackages" bucket)

  // false = the PDF is made from this package and is remade each time it is saved.
  // true = the admin uploaded their own PDF, which is left alone.
  quotationManual Boolean  @default(false)
  rates           Json? // prices in the PDF: [{ label, ages, price }]. Empty = the default rates
  fairPrice       String[] @default([]) // reasons for "Why this price is fair", e.g. "Title: explanation"

  active      Boolean        @default(true) // false = draft, hidden from the website
  route       String[] // stops in travel order
  inclusions  String[]
  exclusions  String[]
  perks       String[]
  itinerary   ItineraryDay[] // the number of days = the package duration
  bookings    Booking[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ItineraryDay {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day         Int // 1, 2, 3 ...
  title       String
  description String
  image       String
  packageId   String  @db.Uuid
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, day])
}

// ---------- Destinations ----------

model Destination {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  group       String // "Wildlife", "Nature", "Culture", ...
  location    String
  image       String
  highlights  String[]
  bestTime    String
  fromKigali  String
  featured    Boolean  @default(false)

  // Choices on the booking form. Empty = the website uses the defaults for the group.
  travelStyles   String[] @default([])
  accommodations String[] @default([])
  budgets        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Workers (staff) ----------

model Worker {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String   @unique
  phone     String
  role      String // name of a Role, e.g. "Tour Guide"
  languages String[]
  status    String   @default("Active") // "Active", "On leave", "Inactive"
  joined    DateTime @default(now())
  notes     String?
  photo     String? // image URL (uploaded to the "workers" bucket)

  // Second role: workers with isAdmin can log in to the admin panel with email + password
  isAdmin      Boolean @default(false)
  passwordHash String? // bcrypt hash, never sent to the browser
  tokenVersion Int     @default(0) // raised on logout and password change: older login tokens stop working

  // The main admin (only one): cannot be deleted, always keeps admin access,
  // and is the only one who can give or remove admin access. Set from .env by the seed.
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Worker roles (managed in Admin > Roles) ----------

// Worker.role holds the role's name. Renaming a role updates its workers too,
// and a role cannot be deleted while workers have it.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique // e.g. "Tour Guide"
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Bookings ----------

model Booking {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer     String
  email        String
  phone        String?
  country      String
  packageId    String?              @db.Uuid // empty when the trip is built from destinations
  package      Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  destinations BookingDestination[]
  startDate    DateTime
  endDate      DateTime
  travelers    Int // adults + children
  children     Int                  @default(0)
  amount       Int // total in USD, 0 until the admin sets the price of a destination trip
  status       String               @default("Pending") // "Pending", "Confirmed", "Completed", "Cancelled"
  payment      String               @default("Unpaid") // "Unpaid", "Deposit", "Paid", "Refunded"
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// One destination of a booking, with what the visitor chose for it.
// The title is stored as text: it can be a place the visitor typed, and it stays if the destination is deleted.
model BookingDestination {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  travelStyle   String
  accommodation String
  budget        String
  bookingId     String  @db.Uuid
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ---------- Messages (contact form) ----------

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  phone      String?
  subject    String
  body       String
  source     String   @default("Contact form") // "Contact form", "Booking request", "WhatsApp"
  read       Boolean  @default(false)
  starred    Boolean  @default(false)
  receivedAt DateTime @default(now())
}

// ---------- Reviews (Testimonials on the home page) ----------

model Review {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  country      String
  rating       Int // 1 to 5
  packageTitle String?
  text         String
  status       String   @default("Pending") // "Pending", "Published", "Hidden"
  createdAt    DateTime @default(now())
}

// ---------- Gallery (photos on the gallery page) ----------

model GalleryItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  category  String // "Wildlife", "Landscapes", "Culture", "People"
  location  String?
  image     String // image URL (uploaded to the "gallery" bucket)
  createdAt DateTime @default(now())
}
