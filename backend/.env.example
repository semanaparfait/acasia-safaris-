# Copy this file to .env and fill in your values.
# Never put real keys or passwords in THIS file: it is committed to git and the repository is public.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Signs the admin login tokens. Make a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-value"
PORT=4000
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4000"
# How many proxies stand in front of the API, so request limits see each visitor's real IP.
# The website forwards /api to the backend (1), plus your host's own proxy online (Render, Railway…: +1).
# Locally (website on :3000 -> API on :4000): 1. Online behind Vercel + Render: 2.
TRUST_PROXY="1"
# Login cookies are https-only when NODE_ENV=production. Set to "true"/"false" to force it.
COOKIE_SECURE=""
# Neon Object Storage (Neon Console > Storage > Connect)
# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3="https://YOUR-BUCKET-HOST.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="us-east-2"

# WhatsApp message to the admins for each new booking (Meta WhatsApp Cloud API).
# Leave the token empty to send nothing. See "WhatsApp alerts" in README.md.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="new_booking"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Sends quotations, booking emails and reset codes. See "Quotation emails" in README.md.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Acacia Safaris <your-address@gmail.com>"

# Main admin (inserted by "npm run admin:main"): can log in, cannot be deleted,
# and is the only one who can give other workers admin access.
OWNER_NAME="Your Name"
OWNER_EMAIL="firstname@acaciasafarisrwanda.com"
OWNER_PASSWORD="a-strong-password-of-12-or-more-characters"
OWNER_PHONE="07XXXXXXXX"
# Your own email (e.g. Gmail): the forgot-password code is sent here
OWNER_PERSONAL_EMAIL=""

# French and Swahili versions of packages and destinations. One of the two (Azure wins if both):
# 1. Azure AI Translator (free tier F0: 2 million characters a month, never charged):
#    Azure portal > Translator > Create (pricing tier Free F0) > Keys and Endpoint:
#    Key 1, and the Location/Region (e.g. switzerlandnorth).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# 2. Google Cloud Translation (Basic v2, needs a billing account): Google Cloud Console >
#    APIs & Services: enable "Cloud Translation API", create an API key restricted to that API.
GOOGLE_TRANSLATE_API_KEY=
# Empty = no automatic translation (admins can still write the translations by hand).

# Nightly encrypted database backups (Admin > Backups). See "Backups" in README.md.
# 1. Neon Console > Storage: create a bucket named "backups" (never one of the image buckets).
# 2. A long random key, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Keep a copy in a password manager: without it, the backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
BACKUP_BUCKET=backups
BACKUP_KEEP_DAYS=30

# Photos and files sent in the booking chat (customer <-> team). PRIVATE bucket:
# Neon Console > Storage: create a bucket named "chat" (never one of the image buckets).
CHAT_BUCKET=chat

# Admin > Statistics: website visitors from Umami (the website sends them, see ../.env.example)
# Free Umami plan: the website's Share URL (Umami > Websites > pencil > Share URL)
UMAMI_SHARE_URL=""
# Paid plan instead (custom charts): an API key and the website id
# UMAMI_API_KEY: Umami > Settings > API keys. UMAMI_WEBSITE_ID: the real website's id.
UMAMI_API_KEY=""
UMAMI_WEBSITE_ID=""
# Self-hosted Umami, or to pin the region: https://api.umami.is/v1/eu
# UMAMI_API_URL="https://api.umami.is/v1"
