# Copy this file to .env and fill in your values.
# Never put real keys or passwords in THIS file: it is committed to git and the repository is public.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Signs the admin login tokens. Make a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-value"
PORT=4000
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4000"
# How many proxies stand in front of the API, so request limits see each visitor's real IP.
# The website forwards /api to the backend (1), plus your host's own proxy online (Render, Railway…: +1).
# Locally (website on :3000 -> API on :4000): 1. Online behind Vercel + Render: 2.
TRUST_PROXY="1"
# Login cookies are https-only when NODE_ENV=production. Set to "true"/"false" to force it.
COOKIE_SECURE=""
# Neon Object Storage (Neon Console > Storage > Connect)
# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3="https://YOUR-BUCKET-HOST.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="us-east-2"

# WhatsApp message to the admins for each new booking (Meta WhatsApp Cloud API).
# Leave the token empty to send nothing. See "WhatsApp alerts" in README.md.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="new_booking"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Sends quotations, booking emails and reset codes. See "Quotation emails" in README.md.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Acacia Safaris <your-address@gmail.com>"

# Main admin (inserted by "npm run admin:main"): can log in, cannot be deleted,
# and is the only one who can give other workers admin access.
OWNER_NAME="Your Name"
OWNER_EMAIL="firstname@acaciasafaris.com"
OWNER_PASSWORD="a-strong-password-of-12-or-more-characters"
OWNER_PHONE="07XXXXXXXX"
# Your own email (e.g. Gmail): the forgot-password code is sent here
OWNER_PERSONAL_EMAIL=""
