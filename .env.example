# The website (Next.js). Copy to .env.local and fill in. Never put secrets here: every
# NEXT_PUBLIC_ value is visible in the browser.

# The backend API, e.g. https://acacia-api.onrender.com/api (locally http://localhost:4000/api)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# This website's public address (sitemap, Google, social previews), e.g. https://acaciasafarisrwanda.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Visitor statistics (Umami, free plan at https://cloud.umami.is). Leave empty to turn off.
# Umami uses no cookies; booking links are hidden before anything is sent (components/Analytics.tsx).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# NEXT_PUBLIC_UMAMI_SRC="https://cloud.umami.is/script.js"
# Count only the live site, not localhost:
# NEXT_PUBLIC_UMAMI_DOMAINS="acaciasafarisrwanda.com"
