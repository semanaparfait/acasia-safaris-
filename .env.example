# The website (Next.js). Copy to .env.local and fill in. Never put secrets here: every
# NEXT_PUBLIC_ value is visible in the browser.

# The backend API, e.g. https://acacia-api.onrender.com/api (locally http://localhost:4000/api)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# This website's public address (sitemap, Google, social previews), e.g. https://acaciasafaris.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
